NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Secret keys belong only in server/GitHub Actions settings. Never prefix them with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ローカルだけで使う代替。GitHub Actionsでは上のJSONをSecretsへ設定する。
GOOGLE_SERVICE_ACCOUNT_FILE=
# 手動実行時だけ任意指定（YYYY-MM-DD）。未指定なら先月1日〜昨日。
SYNC_START_DATE=
SYNC_END_DATE=
SYNC_TRIGGER=manual
